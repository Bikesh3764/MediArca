generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          String         @default("PATIENT") // "PATIENT", "DOCTOR", "ADMIN"
  avatarUrl     String?
  mustChangePassword Boolean   @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  doctorProfile       DoctorProfile?
  patientProfile      PatientProfile?
  clinicProfile       ClinicProfile?
  receptionistProfile ReceptionistProfile?
  reviews             Review[]
  notifications       Notification[]
}

model DoctorProfile {
  id                    String        @id @default(uuid())
  userId                String        @unique
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty             String
  qualifications        String
  experienceYears       Int           @default(0)
  consultationFee       Float         @default(0.0)
  bio                   String?
  clinicAddress         String?
  isVerified            Boolean       @default(false)
  verificationStatus    String        @default("PENDING") // "PENDING", "VERIFIED", "SUSPENDED", "REJECTED"
  checkingStartTime     String        @default("09:00")
  checkingEndTime       String        @default("13:00")
  avgConsultationMinutes Int          @default(15)
  maxDailyPatients      Int           @default(30)
  rating                Float         @default(5.0)
  totalReviews          Int           @default(0)
  slots                 String?       // JSON array of DoctorSlot[]: [{id, name, startTime, endTime, maxPatients, avgConsultationMinutes}]

  appointments          Appointment[]
  reviews               Review[]
  clinics               ClinicDoctor[]
  receptionists         DoctorReceptionist[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model PatientProfile {
  id                 String          @id @default(uuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth        String?
  gender             String?
  bloodGroup         String?
  allergies          String?
  existingConditions String?
  currentMedications String?
  emergencyContact   String?

  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Appointment {
  id              String         @id @default(uuid())
  patientId       String
  patient         PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId        String?
  clinic          ClinicProfile? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  appointmentDate String         // Format: YYYY-MM-DD
  queueNumber     Int            // 1, 2, 3...
  checkingWindow  String         // e.g. "09:00 AM - 01:00 PM"
  estimatedTime   String         // e.g. "09:30 AM"
  status          String         @default("WAITING") // "WAITING", "IN_CONSULTATION", "COMPLETED", "CANCELLED"
  reasonForVisit  String?
  symptoms        String?
  vitals          String?        // JSON string: { bp, pulse, temp, weight }
  clinicalNotes   String?
  slotId          String?        // ID of specific doctor checking slot
  isForOther      Boolean        @default(false)
  patientName     String?
  patientAge      String?
  patientGender   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  prescription    Prescription?
  review          Review?

  @@unique([doctorId, appointmentDate, queueNumber])
}

model Prescription {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  diagnosis     String
  medicines     String      // JSON string: array of medicine objects
  advice        String?
  followUpDate  String?
  createdAt     DateTime    @default(now())
}

model MedicalRecord {
  id          String         @id @default(uuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String
  category    String         // "Prescription", "Lab Report", "Scan", "Discharge Summary", "Other"
  fileUrl     String
  fileType    String?
  uploadedAt  DateTime       @default(now())
}

model Review {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId     String
  patientUser   User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rating        Int           // 1 to 5
  comment       String?
  createdAt     DateTime      @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ClinicProfile {
  id           String                @id @default(uuid())
  userId       String                @unique
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicName   String
  address      String
  city         String?
  phone        String?
  isVerified   Boolean               @default(false)
  verificationStatus String            @default("PENDING") // "PENDING", "VERIFIED", "SUSPENDED", "REJECTED"
  doctors      ClinicDoctor[]
  receptionists ReceptionistProfile[]
  appointments Appointment[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model ReceptionistProfile {
  id        String               @id @default(uuid())
  userId    String               @unique
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  clinicId  String?
  clinic    ClinicProfile?       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctors   DoctorReceptionist[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ClinicDoctor {
  id          String        @id @default(uuid())
  clinicId    String
  clinic      ClinicProfile @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status      String        @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "ACTIVE"
  requestedBy String        @default("CLINIC")  // "CLINIC" or "DOCTOR"
  createdAt   DateTime      @default(now())

  @@unique([clinicId, doctorId])
}

model DoctorReceptionist {
  id             String              @id @default(uuid())
  doctorId       String
  doctor         DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  receptionistId String
  receptionist   ReceptionistProfile @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  status         String              @default("ACTIVE")
  createdAt      DateTime            @default(now())

  @@unique([doctorId, receptionistId])
}
